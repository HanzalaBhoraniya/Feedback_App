<file path="client/src/components/AnalyticsDashboard.css">
/* AnalyticsDashboard.css */
.dashboard-container {
  display: flex;
  min-height: 100vh;
  background-color: transparent; /* Deep dark background */
  color: #fafafa;
  font-family: "Inter", sans-serif;
}


.sharingBtnWrapper {
  height: 100%;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 7px;
  cursor: pointer;
}

.sharingBtn {
  text-decoration: none;
  padding: 8px 10px;
  /* background-color: blue; */
  flex: 1;
  border-radius: 10px;
  text-align: center;
  color: white;
  font-weight: 500;
  border: 2px solid transparent;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.getQrBtn {
  background-color: #863bff;
}

.copyLink {
  background-color: transparent;
  border: 2px solid #863bff;
}

/* Main Content */
.loadingScreen {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  max-height: 100vh;
}
.dashboard-header {
  margin-bottom: 20px;
}
.subtitle {
  color: #a1a1aa;
  font-size: 12px;
  letter-spacing: 1px;
  margin-bottom: 4px;
}
.dashboard-header h1 {
  margin: 0;
  font-size: 28px;
}

/* Grid Layouts */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-bottom: 20px;
  width: auto;
}
.charts-grid {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
  margin-bottom: 20px;
}

/* Cards */
.stat-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
}
.stat-card,
.chart-card,
.table-section {
  background-color: #141417;
  border: 1px solid #27272a;
  border-radius: 12px;
  padding: 20px;
}
.chart-card {
  width: 100%;
}
.stat-card h3,
.chart-card h3,
.table-section h3 {
  font-size: 15px;
  font-weight: 600;
  color: #a1a1aa;
  margin-top: 0;
  margin-bottom: 8px;
}
