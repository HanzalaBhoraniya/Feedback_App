                  <td>
                    <div className="messageTable" title={e.message}>
                      {e.message}
                    </div>
                  </td>

                  <td>{formatTime(timeStamp)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </section>
    </main>
  );
}

export default AnalyticsDashboard;
